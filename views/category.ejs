<% categoryArticles = paginatedArticles.data %>
<!-- post-container -->
    <div class="post-container">
        <h2 class="page-heading"><%= category.name %></h2>
        <% categoryArticles.forEach(article => { %>
        <div class="post-content">
            <div class="row">
            <div class="col-md-4">
                <a class="post-img" href="/single/<%= article.id %>"><img src="/uploads/<%= article.image %>" alt=""/></a>
            </div>
            <div class="col-md-8">
                <div class="inner-content clearfix">
                    <h3><a href='/single/<%= article.id %>'><%= article.title %></a></h3>
                    <div class="post-information">
                    <span>
                        <i class="fa fa-tags" aria-hidden="true"></i>
                        <a href='/category/<%= article.category.slug %>'><%= article.category.name %></a>
                    </span>
                    <span>
                        <i class="fa fa-user" aria-hidden="true"></i>
                        <a href='/author/<%= article.author.fullname %>'><%= article.author.fullname %></a>
                    </span>
                    <span>
                        <i class="fa fa-calendar" aria-hidden="true"></i>
                        <%= article.createdAt.toDateString() %>
                    </span>
                    </div>
                    <p class="description">
                        <%= article.content %>
                    </p>
                    <a class='read-more pull-right' href='/single/<%= article.id %>'>read more</a>
                </div>
            </div>
            </div>
        </div>
        <% }); %>
        <% 
            const currentPage = paginatedArticles.page != null ? paginatedArticles.page
                : (paginatedArticles.currentPage != null ? paginatedArticles.currentPage
                : (paginatedArticles.pagination && paginatedArticles.pagination.page) || 1);
            const totalPages = paginatedArticles.pages != null ? paginatedArticles.pages
                : (paginatedArticles.totalPages != null ? paginatedArticles.totalPages
                : (paginatedArticles.pageCount != null ? paginatedArticles.pageCount
                : (paginatedArticles.pagination && (paginatedArticles.pagination.pages || paginatedArticles.pagination.totalPages || paginatedArticles.pagination.pageCount)) || 1));
            const prevPage = paginatedArticles.prevPage != null ? paginatedArticles.prevPage
                : (currentPage > 1 ? currentPage - 1 : null);
            const nextPage = paginatedArticles.nextPage != null ? paginatedArticles.nextPage
                : (currentPage < totalPages ? currentPage + 1 : null);
        %>
        <nav>
        <ul class="pagination">
            <li class="page-item <%= !prevPage ? 'disabled' : '' %>">
            <a class="page-link" href="<%= prevPage ? '?page=' + prevPage : '#' %>">Previous</a>
            </li>
            <% for (let page = 1; page <= totalPages; page++) { %>
            <li class="page-item <%= page === currentPage ? 'active' : '' %>">
                <a class="page-link" href="<%= page === currentPage ? '#' : '?page=' + page %>" <%= page === currentPage ? 'aria-current="page"' : '' %>><%= page %></a>
            </li>
            <% } %>
            <li class="page-item <%= !nextPage ? 'disabled' : '' %>">
            <a class="page-link" href="<%= nextPage ? '?page=' + nextPage : '#' %>">Next</a>
            </li>
        </ul>
        </nav>
    </div>
<!-- /post-container -->