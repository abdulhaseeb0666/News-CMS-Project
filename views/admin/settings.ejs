  <div id="admin-content">
      <div class="container">
          <div class="row">
              <div class="col-md-12">
                <h1 class="admin-heading"><i class="fa fa-cog"></i> Settings</h1>
              </div>
              <div class="col-md-6 mx-auto">
                  <div class="card">
                    <h5 class="card-header">Settings</h5>
                    <div class="card-body">
                      <form action="/admin/save-settings" method="POST" enctype="multipart/form-data">
                          <div class="mb-3">
                              <label for="website_title" class="form-label">Website Title</label>
                              <input type="text" name="website_title" value="<%= settings.website_title %>" class="form-control" autocomplete="off" required>
                          </div>
                          <div class="mb-3">
                              <label for="website_logo" class="form-label">Upload Logo</label> <br>
                              <img src="/uploads/<%= settings.website_logo %>" style="height: 100px; width: fit-content; object-fit: cover; margin-bottom: 5px; border: 2px solid #000; box-shadow: gray 4px 2px 5px; border-radius: 5px;" alt="website logo">
                              <input type="file" name="website_logo" class="form-control">
                          </div>
                          <div class="mb-3">
                              <label for="footer_description" class="form-label">Footer Description</label>
                              <input type="text" name="footer_description" value="<%= settings.footer_description %>" class="form-control" autocomplete="off" required>
                          </div>
                          
                          <input type="submit" name="submit" class="btn btn-primary" value="Save" required="">
                      </form>
                    </div>
                  </div>
              </div>
          </div>
      </div>
  </div>