<div id="admin-content">
      <div class="container">
      <div class="row">
        <div class="col-md-12">
            <h1 class="admin-heading">Update Article</h1>
        </div>
        <div class="col-md-8 mx-auto">
          <div class="card">
            <h5 class="card-header">Update Article</h5>
            <div class="card-body">
              <!-- Form -->
              <form action="/admin/update-article/<%= article._id %>" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="article_title" class="form-label">Title</label>
                    <input type="text" name="title" value="<%= article.title %>" id="article_title" class="form-control" autocomplete="off" required>
                </div>
                <div class="mb-3">
                    <label for="summernote" class="form-label">Description</label>
                    <input name="content" id="summernote" value="<%= article.content %>" class="form-control" rows="5"  required></input>
                </div>
                <div class="mb-3">
                    <label for="article_category" class="form-label">Category</label>
                    <select name="category" id="article_category" class="form-control" required>
                        <option selected disabled> Select Category</option>
                        <% categories.forEach((category) => { %>
                          <option value="<%= category._id %>"> <%= category.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="article_image" class="form-label">Article image</label> <br>
                    <img src="/uploads/<%= article.image %>" style="width: fit; height: 100px; object-fit: cover; margin-bottom: 5px; border: 2px solid #000; box-shadow: gray 4px 2px 5px; border-radius: 5px; " alt="old-image" class="article-image">
                    <input type="file" name="image" id="article_image" class="form-control">
                </div>
                <input type="submit" name="submit" class="btn btn-primary" value="Update" />
                <%- include("../partials/error") %>

              </form>
              <!--/Form -->
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>