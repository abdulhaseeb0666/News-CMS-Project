<div id="sidebar" class="col-md-4">
    <!-- search box -->
    <div class="search-box-container">
        <h4>Search</h4>
        <form class="search-post" action="search.html" method ="GET">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Search .....">
                <span class="input-group-btn">
                    <button type="submit" class="btn btn-danger">Search</button>
                </span>
            </div>
        </form>
    </div>
    <!-- /search box -->
    <!-- recent posts box -->
    <div class="recent-post-container">
        <h4>Recent Posts</h4>
        <% articles.splice(0, 5).forEach(article => { %>
        <div class="recent-post">
            <a class="post-img" href="">
                <img src="/uploads/<%= article.image %>" alt=""/>
            </a>
            <div class="post-content">
                <h5><a href="/single/<%= article.id %>"><%= article.title %></a></h5>
                <span>
                    <i class="fa fa-tags" aria-hidden="true"></i>
                    <a href='/category/<%= article.category.slug %>'><%= article.category.name %></a>
                </span>
                <span>
                    <i class="fa fa-calendar" aria-hidden="true"></i>
                    <%= article.createdAt.toDateString() %>
                </span>
                <a class="read-more" href="/single/<%= article.id %>">read more</a>
            </div>
        </div>
        <% }) %>
    </div>
    <!-- /recent posts box -->
</div>